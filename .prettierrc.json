{
  "printWidth": 90,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "*.gs",
      "options": {
        "parser": "babel"
      }
    },
    {
      "files": "supabase/*-dashboard.txt",
      "options": {
        "parser": "babel"
      }
    }
  ]
}
